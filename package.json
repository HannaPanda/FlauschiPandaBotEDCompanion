{
  "name": "ed-companion",
  "version": "1.0.3",
  "description": "Elite Dangerous Live Monitoring Companion",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on dist/main/index.js && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "dist": "npm run build && electron-builder --win portable",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.0.0"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "electron-store": "^7.0.3",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "ws": "^8.17.0"
  },
  "build": {
    "appId": "de.flauschipandabot.ed-companion",
    "productName": "ED Companion",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/main/**/*",
      "src/renderer/splash.html",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-renderer",
        "to": "renderer"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "ED-Companion-portable.exe"
    }
  }
}
